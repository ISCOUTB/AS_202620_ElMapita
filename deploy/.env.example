# El Mapita UTB — Variables de entorno de ejemplo para pruebas locales
# Copia este archivo a deploy/.env y reemplaza los valores con los reales.
# IMPORTANTE: deploy/.env va en .gitignore y NUNCA se sube al repositorio con valores reales.
# Los valores secretos reales se configuran en el panel de iscoutb.dev (pestaña Environment).

PORT=3000
NODE_ENV=production
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-de-ejemplo
SUPABASE_ANON_KEY=tu-anon-key-de-ejemplo
FRONTEND_URL=https://elmapita.iscoutb.dev
LOG_LEVEL=info
